# Global repository fallback for all challenge projects.
# Keep project-specific exceptions and framework rules in each project's .gitignore.

# design files
*.sketch
*.fig
*.xd

# Dependencies
node_modules/
.pnp/
.pnp.*

# Environment files and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem

# Build and test output
coverage/
build/
dist/
dist-ssr/
.next/
out/
.vite/
.turbo/
.vercel/

# Tool caches
*.tsbuildinfo
.eslintcache
.stylelintcache

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors
.idea/
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
